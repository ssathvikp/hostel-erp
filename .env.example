# Copy to .env.local and fill in values from the Supabase dashboard
# (Project Settings -> API). Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/clickup/sync-plan.ps1.
CLICKUP_API_TOKEN=
