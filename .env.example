# Environment variables. Never commit .env.local.
#
# Local development: start Supabase with `npm run db:start`, then run
# `npm run env:local` to write the Supabase values below into .env.local.
#
# Hosted (staging): copy values from the Supabase dashboard, Project
# Settings -> API Keys. The publishable and secret keys go in the
# ANON_KEY and SERVICE_ROLE_KEY variables respectively.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: keys the hash of resident ID numbers used for duplicate
# detection. 64 random hex characters (`npm run env:local` generates one).
# Never change it once residents exist: old hashes would stop matching.
ID_PROOF_HMAC_KEY=

# Direct Postgres connection for the database test suites. Local only.
SUPABASE_DB_URL=

# Used only by scripts/clickup/sync-plan.ps1.
CLICKUP_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional until the business accounts exist (docs/billing.md). Leave empty
# locally: the app explains that online payment is not set up yet.
# ---------------------------------------------------------------------------

# Server only. Hostel ERP's own Razorpay account, for owners' subscriptions
# (EP-14). Dashboard -> Account & Settings -> API Keys, and Webhooks.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server only. Encrypts each owner's own Razorpay keys for rent collection
# (E13-T10). 64 random hex characters; never change it once owners have
# connected their accounts.
PAYMENT_KEYS_ENCRYPTION_KEY=

# The public URL of this deployment, used in payment links, QR codes and
# emails. Locally http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# The business behind Hostel ERP, shown on the legal pages (E14-T11).
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_SUPPORT_PHONE=
LEGAL_GRIEVANCE_OFFICER=
LEGAL_GRIEVANCE_EMAIL=
LEGAL_JURISDICTION_CITY=
