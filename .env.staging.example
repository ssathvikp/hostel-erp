# Staging values. Copy to .env.staging (git-ignored) and fill in.
# docs/staging.md says where each one comes from.

# The deployed site, e.g. https://hostel-erp-staging.vercel.app
STAGING_SITE_URL=
# Optional: more allowed redirect URLs, comma-separated (Vercel previews).
STAGING_REDIRECT_URLS=

# Supabase staging project. Project ref is the 20 characters in the
# dashboard URL; the keys are under Project Settings -> API Keys.
STAGING_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A personal access token (supabase.com/dashboard/account/tokens), used
# only by `npm run staging:auth`.
SUPABASE_ACCESS_TOKEN=

# Custom SMTP provider for auth emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Hostel ERP

# Razorpay test-mode keys for staging (docs/billing.md). Set in Vercel.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_KEYS_ENCRYPTION_KEY=
NEXT_PUBLIC_SITE_URL=
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_RESIDENT_CODE=
MSG91_TEMPLATE_COMPLAINT_UPDATE=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
